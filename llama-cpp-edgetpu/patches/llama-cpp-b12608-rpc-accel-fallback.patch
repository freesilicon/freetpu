+static bool rpc_op_is_supported_on_rpc(const ggml_tensor * node) {
+    if (node == nullptr || (uint32_t) node->op >= GGML_OP_COUNT) {
+        return false;
+    }
+    switch (node->op) {
+        case GGML_OP_MAP_CUSTOM1:
+        case GGML_OP_MAP_CUSTOM2:
+        case GGML_OP_MAP_CUSTOM3:
+        case GGML_OP_CUSTOM:
+            // Custom ops carry process-local function pointers in op_params.
+            return false;
+        default:
+            return true;
+    }
+}
+
+static bool rpc_tensor_storage_in_bounds(
+        const ggml_tensor * t,
+        const std::unordered_set<ggml_backend_buffer_t> & buffers,
+        int depth = 0) {
+    if (t == nullptr || depth > 32 || (uint32_t) t->type >= GGML_TYPE_COUNT) {
+        return false;
+    }
+    const int64_t blck_size = ggml_blck_size(t->type);
+    const size_t  type_size = ggml_type_size(t->type);
+    if (blck_size <= 0 || type_size == 0) {
+        return false;
+    }
+    bool is_empty = false;
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+        if (t->ne[d] < 0 || (uint64_t) t->nb[d] > (uint64_t) INT64_MAX) {
+            return false;
+        }
+        if (t->ne[d] == 0) {
+            is_empty = true;
+        }
+    }
+
+    ggml_backend_buffer_t buf = t->buffer;
+    if (buf == nullptr || buffers.find(buf) == buffers.end() ||
+        !ggml_backend_buffer_is_host(buf) || t->data == nullptr) {
+        return false;
+    }
+
+    uint64_t span = 0;
+    if (!is_empty) {
+        if ((t->ne[0] % blck_size) != 0 || t->nb[0] < type_size) {
+            return false;
+        }
+        int first_dim = 0;
+        if (blck_size > 1) {
+            const uint64_t n_blocks = (uint64_t) (t->ne[0] / blck_size);
+            if (n_blocks > UINT64_MAX / (uint64_t) t->nb[0]) {
+                return false;
+            }
+            span = n_blocks * (uint64_t) t->nb[0];
+            first_dim = 1;
+        } else {
+            span = (uint64_t) type_size;
+        }
+        for (int d = first_dim; d < GGML_MAX_DIMS; ++d) {
+            const uint64_t count  = (uint64_t) (t->ne[d] - 1);
+            const uint64_t stride = (uint64_t) t->nb[d];
+            if (count != 0) {
+                if (stride < type_size || stride > (UINT64_MAX - span) / count) {
+                    return false;
+                }
+                span += count * stride;
+            }
+        }
+    }
+
+    const uint64_t base     = (uint64_t) (uintptr_t) ggml_backend_buffer_get_base(buf);
+    const uint64_t buf_size = (uint64_t) ggml_backend_buffer_get_size(buf);
+    const uint64_t data     = (uint64_t) (uintptr_t) t->data;
+    if (base == 0 || data < base || (data - base) > buf_size || span > buf_size - (data - base)) {
+        return false;
+    }
+
+    if (t->view_src != nullptr) {
+        if (!rpc_tensor_storage_in_bounds(t->view_src, buffers, depth + 1)) {
+            return false;
+        }
+        const uint64_t src_data = (uint64_t) (uintptr_t) t->view_src->data;
+        if (t->view_src->buffer != buf ||
+            (uint64_t) t->view_offs > UINT64_MAX - src_data ||
+            src_data + (uint64_t) t->view_offs != data) {
+            return false;
+        }
+    }
+    return true;
 }
 
+static bool rpc_node_storage_valid(
+        const ggml_tensor * node,
+        const std::unordered_set<ggml_backend_buffer_t> & buffers) {
+    if (!rpc_tensor_storage_in_bounds(node, buffers)) {
+        return false;
+    }
+    for (int s = 0; s < GGML_MAX_SRC; ++s) {
+        if (node->src[s] != nullptr && !rpc_tensor_storage_in_bounds(node->src[s], buffers)) {
+            return false;
+        }
+    }
+    return true;
+}
