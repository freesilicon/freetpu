+static bool rpc_op_is_supported_on_rpc(const ggml_tensor * node) {
+    if (node == nullptr || (uint32_t) node->op >= GGML_OP_COUNT) {
+        return false;
+    }
+    switch (node->op) {
+        case GGML_OP_MAP_CUSTOM1:
+        case GGML_OP_MAP_CUSTOM2:
+        case GGML_OP_MAP_CUSTOM3:
+        case GGML_OP_CUSTOM:
+            // Custom ops carry process-local function pointers in op_params.
+            return false;
+        default:
+            return true;
+    }
+}
