+static bool rpc_op_is_supported_on_rpc(const ggml_tensor * node) {
+    if (node == nullptr || (uint32_t) node->op >= GGML_OP_COUNT) {
+        return false;
+    }
+    return node->op != GGML_OP_MAP_CUSTOM1 && node->op != GGML_OP_MAP_CUSTOM2 &&
+           node->op != GGML_OP_MAP_CUSTOM3 && node->op != GGML_OP_CUSTOM;
+}
+
+static bool rpc_op_is_noop(enum ggml_op op) {
+    return op == GGML_OP_NONE || op == GGML_OP_RESHAPE || op == GGML_OP_VIEW ||
+           op == GGML_OP_PERMUTE || op == GGML_OP_TRANSPOSE;
+}
+
+static bool rpc_tensor_storage_in_bounds(
+        const ggml_tensor * t,
+        const std::unordered_set<ggml_backend_buffer_t> & buffers,
+        int depth = 0) {
+    if (t == nullptr || depth > 32 || (uint32_t) t->type >= GGML_TYPE_COUNT) {
+        return false;
+    }
+    const int64_t blck_size = ggml_blck_size(t->type);
+    const size_t  type_size = ggml_type_size(t->type);
+    if (blck_size <= 0 || type_size == 0) {
+        return false;
+    }
+    bool is_empty = false;
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+        if (t->ne[d] < 0 || (uint64_t) t->nb[d] > (uint64_t) INT64_MAX) {
+            return false;
+        }
+        is_empty = is_empty || (t->ne[d] == 0);
+    }
+    ggml_backend_buffer_t buf = t->buffer;
+    if (buf == nullptr || buffers.find(buf) == buffers.end() ||
+        !ggml_backend_buffer_is_host(buf) || t->data == nullptr) {
+        return false;
+    }
+    uint64_t span = 0;
+    if (!is_empty) {
+        if ((t->ne[0] % blck_size) != 0 || t->nb[0] < type_size) {
+            return false;
+        }
+        int first_dim = 0;
+        if (blck_size > 1) {
+            const uint64_t n_blocks = (uint64_t) (t->ne[0] / blck_size);
+            if (n_blocks > UINT64_MAX / (uint64_t) t->nb[0]) {
+                return false;
+            }
+            span = n_blocks * (uint64_t) t->nb[0];
+            first_dim = 1;
+        } else {
+            span = (uint64_t) type_size;
+        }
+        for (int d = first_dim; d < GGML_MAX_DIMS; ++d) {
+            const uint64_t count  = (uint64_t) (t->ne[d] - 1);
+            const uint64_t stride = (uint64_t) t->nb[d];
+            if (count != 0) {
+                if (stride < type_size || stride > (UINT64_MAX - span) / count) {
+                    return false;
+                }
+                span += count * stride;
+            }
+        }
+    }
+    const uint64_t base     = (uint64_t) (uintptr_t) ggml_backend_buffer_get_base(buf);
+    const uint64_t buf_size = (uint64_t) ggml_backend_buffer_get_size(buf);
+    const uint64_t data     = (uint64_t) (uintptr_t) t->data;
+    if (base == 0 || data < base || (data - base) > buf_size || span > buf_size - (data - base)) {
+        return false;
+    }
+    if (t->view_src != nullptr) {
+        if (!rpc_tensor_storage_in_bounds(t->view_src, buffers, depth + 1)) {
+            return false;
+        }
+        const uint64_t src_data = (uint64_t) (uintptr_t) t->view_src->data;
+        if (t->view_src->buffer != buf || (uint64_t) t->view_offs > UINT64_MAX - src_data ||
+            src_data + (uint64_t) t->view_offs != data) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool rpc_node_storage_valid(
+        const ggml_tensor * node,
+        const std::unordered_set<ggml_backend_buffer_t> & buffers) {
+    if (!rpc_tensor_storage_in_bounds(node, buffers)) {
+        return false;
+    }
+    for (int s = 0; s < GGML_MAX_SRC; ++s) {
+        if (node->src[s] != nullptr && !rpc_tensor_storage_in_bounds(node->src[s], buffers)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool rpc_accel_native_mul_mat_id_supported(const ggml_tensor * node) {
+    if (node == nullptr || node->op != GGML_OP_MUL_MAT_ID) {
+        return false;
+    }
+    const ggml_tensor * src0 = node->src[0];
+    const ggml_tensor * src1 = node->src[1];
+    const ggml_tensor * ids  = node->src[2];
+    const enum ggml_prec prec = ggml_prec_get_src(node, 1);
+    if (!src0 || !src1 || !ids || node->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32 ||
+        (src0->type != GGML_TYPE_Q8_0 && src0->type != GGML_TYPE_Q4_0) ||
+        (src1->type != GGML_TYPE_F32  && src1->type != GGML_TYPE_Q8_0) ||
+        prec == GGML_PREC_F32 || prec == GGML_PREC_BF16 || prec == GGML_PREC_F16 ||
+        ggml_get_op_params_i32(node, 1) == GGML_HINT_SRC0_IS_HADAMARD) {
+        return false;
+    }
+    return src0->ne[0] > 0 && (src0->ne[0] % 32) == 0 && src0->ne[1] > 0 && src0->ne[2] > 0 &&
+           ids->ne[0] > 0 && ids->ne[1] > 0 && src0->ne[3] == 1 && src1->ne[3] == 1 &&
+           ids->ne[2] == 1 && ids->ne[3] == 1 && node->ne[3] == 1 &&
+           src1->ne[0] == src0->ne[0] && src1->ne[2] == ids->ne[1] &&
+           (src1->ne[1] == 1 || src1->ne[1] == ids->ne[0]) &&
+           node->ne[0] == src0->ne[1] && node->ne[1] == ids->ne[0] && node->ne[2] == ids->ne[1] &&
+           ggml_is_contiguous_2(src0) && ggml_is_contiguous_1(src1) && ggml_is_contiguous_1(node) &&
+           src0->nb[0] == ggml_type_size(src0->type) &&
+           (src0->ne[1] == 1 || src0->nb[1] == ggml_row_size(src0->type, src0->ne[0])) &&
+           src1->nb[0] == ggml_type_size(src1->type) &&
+           ids->nb[0] == sizeof(int32_t) && node->nb[0] == sizeof(float);
+}
+
+static bool rpc_cpu_fallback_op_valid(ggml_backend_dev_t cpu_dev, const ggml_tensor * node) {
+    if (node == nullptr) {
+        return false;
+    }
+    if (rpc_op_is_noop(node->op)) {
+        return true;
+    }
+    auto f32_contig = [](const ggml_tensor * t) {
+        return t != nullptr && !ggml_is_empty(t) && t->type == GGML_TYPE_F32 &&
+               t->nb[0] == sizeof(float) && ggml_is_contiguous(t) &&
+               t->ne[0] <= INT32_MAX / 2 && ggml_nrows(t) <= INT32_MAX / 2;
+    };
+    auto row_contig = [](const ggml_tensor * t) {
+        return t != nullptr && !ggml_is_empty(t) && (uint32_t) t->type < GGML_TYPE_COUNT &&
+               ggml_blck_size(t->type) > 0 && (t->ne[0] % ggml_blck_size(t->type)) == 0 &&
+               t->nb[0] == ggml_type_size(t->type) && ggml_is_contiguous_rows(t);
+    };
+    switch (node->op) {
+        case GGML_OP_SCALE:
+        case GGML_OP_RMS_NORM: {
+            const ggml_tensor * src0 = node->src[0];
+            if (!f32_contig(node) || !f32_contig(src0) || !ggml_are_same_shape(src0, node)) {
+                return false;
+            }
+            if (node->op == GGML_OP_RMS_NORM) {
+                float eps = -1.0f;
+                memcpy(&eps, node->op_params, sizeof(float));
+                if (!(eps >= 0.0f)) { return false; }
+            }
+            return cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node);
+        }
+        case GGML_OP_ADD:
+        case GGML_OP_SUB:
+        case GGML_OP_MUL:
+        case GGML_OP_DIV: {
+            const ggml_tensor * src0 = node->src[0];
+            const ggml_tensor * src1 = node->src[1];
+            return f32_contig(node) && f32_contig(src0) && f32_contig(src1) &&
+                   ggml_are_same_shape(src0, node) && ggml_can_repeat(src1, src0) &&
+                   (cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node));
+        }
+        case GGML_OP_MUL_MAT: {
+            const ggml_tensor * src0 = node->src[0];
+            const ggml_tensor * src1 = node->src[1];
+            if (ggml_get_op_params_i32(node, 1) == GGML_HINT_SRC0_IS_HADAMARD ||
+                !row_contig(node) || !row_contig(src0) || !row_contig(src1) ||
+                node->type != GGML_TYPE_F32 ||
+                !(node->nb[0] <= node->nb[1] && node->nb[1] <= node->nb[2] && node->nb[2] <= node->nb[3]) ||
+                (src1->type != GGML_TYPE_F32 && src1->type != GGML_TYPE_F16 && src1->type != GGML_TYPE_BF16) ||
+                (src0->type != GGML_TYPE_F32 && src0->type != GGML_TYPE_F16 && src0->type != GGML_TYPE_BF16 &&
+                 ggml_get_type_traits(src0->type)->to_float == nullptr)) {
+                return false;
+            }
+            return src0->ne[0] == src1->ne[0] && node->ne[0] == src0->ne[1] &&
+                   node->ne[1] == src1->ne[1] && node->ne[2] == src1->ne[2] && node->ne[3] == src1->ne[3] &&
+                   (src1->ne[2] % src0->ne[2]) == 0 && (src1->ne[3] % src0->ne[3]) == 0 &&
+                   (cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node));
+        }
+        default:
+            return false;
+    }
+}
