+ggml_status rpc_server::compute_graph_with_accel_fallback(uint32_t device, ggml_cgraph * graph) {
+    for (int k = 0; k < graph->n_nodes; ++k) {
+        if (graph->nodes[k] != nullptr && !rpc_op_is_supported_on_rpc(graph->nodes[k])) {
+            return GGML_STATUS_FAILED;
+        }
+    }
+    ggml_backend_t backend = backends[device];
+    if (!cpu_fallback || !rpc_backend_is_edgetpu_accel(backend)) {
+        return ggml_backend_graph_compute_async(backend, graph);
+    }
+    ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+    ggml_backend_dev_t cpu_dev = ggml_backend_get_device(cpu_fallback);
+    int i = 0;
+    while (i < graph->n_nodes) {
+        while (i < graph->n_nodes &&
+               (graph->nodes[i] == nullptr || (graph->nodes[i]->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+                rpc_op_is_noop(graph->nodes[i]->op))) { ++i; }
+        if (i >= graph->n_nodes) { break; }
+        if (!rpc_node_storage_valid(graph->nodes[i], buffers)) { return GGML_STATUS_FAILED; }
+        const bool use_accel = ggml_backend_dev_supports_op(dev, graph->nodes[i]);
+        int j = i + 1;
+        while (j < graph->n_nodes) {
+            if (!use_accel && rpc_op_checks_indices(graph->nodes[i]->op)) { break; }
+            ggml_tensor * node = graph->nodes[j];
+            if (node == nullptr || (node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || rpc_op_is_noop(node->op)) { break; }
+            if (!rpc_node_storage_valid(node, buffers)) { return GGML_STATUS_FAILED; }
+            if (ggml_backend_dev_supports_op(dev, node) != use_accel) { break; }
+            if (!use_accel && rpc_op_checks_indices(node->op)) { break; }
+            ++j;
+        }
+        struct ggml_cgraph sub = ggml_graph_view(graph, i, j);
+        ggml_status status = GGML_STATUS_SUCCESS;
+        if (use_accel) {
+            status = ggml_backend_graph_compute_async(backend, &sub);
+            if (status == GGML_STATUS_SUCCESS) { ggml_backend_synchronize(backend); }
+        } else {
+            for (int k = i; k < j; ++k) {
+                if (cpu_dev == nullptr || !rpc_cpu_fallback_op_valid(cpu_dev, graph->nodes[k]) ||
+                    (rpc_op_checks_indices(graph->nodes[k]->op) && !rpc_cpu_fallback_indices_valid(graph->nodes[k]))) {
+                    return GGML_STATUS_FAILED;
+                }
+            }
+            status = ggml_backend_graph_compute(cpu_fallback, &sub);
+        }
+        if (status != GGML_STATUS_SUCCESS) { return status; }
+        i = j;
+    }
+    return GGML_STATUS_SUCCESS;
+}
