+static bool rpc_u64_mul_checked(uint64_t a, uint64_t b, uint64_t * out) {
+    if (a != 0 && b > UINT64_MAX / a) {
+        return false;
+    }
+    *out = a * b;
+    return true;
+}
+
+static bool rpc_u64_add_checked(uint64_t a, uint64_t b, uint64_t * out) {
+    if (b > UINT64_MAX - a) {
+        return false;
+    }
+    *out = a + b;
+    return true;
+}
+
+static bool rpc_ranges_overlap(uint64_t a0, uint64_t a1, uint64_t b0, uint64_t b1) {
+    return a0 < b1 && b0 < a1;
+}
+
+static bool rpc_op_is_noop(enum ggml_op op) {
+    switch (op) {
+        case GGML_OP_NONE:
+        case GGML_OP_RESHAPE:
+        case GGML_OP_VIEW:
+        case GGML_OP_PERMUTE:
+        case GGML_OP_TRANSPOSE:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static bool rpc_tensor_span_in_buffer(
+        const ggml_tensor * t,
+        const std::unordered_set<ggml_backend_buffer_t> & buffers,
+        bool require_contiguous_rows,
+        uint64_t * out_start = nullptr,
+        uint64_t * out_end   = nullptr) {
+    if (t == nullptr || t->buffer == nullptr || t->data == nullptr) {
+        return false;
+    }
+    if (buffers.find(t->buffer) == buffers.end()) {
+        return false;
+    }
+    if ((uint32_t) t->type >= GGML_TYPE_COUNT) {
+        return false;
+    }
+    const int64_t blck_size = ggml_blck_size(t->type);
+    const size_t  type_size = ggml_type_size(t->type);
+    if (blck_size <= 0 || type_size == 0) {
+        return false;
+    }
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+        if (t->ne[d] <= 0) {
+            return false;
+        }
+    }
+    if (t->ne[0] % blck_size != 0) {
+        return false;
+    }
+    if (require_contiguous_rows && !ggml_is_contiguous_rows(t)) {
+        return false;
+    }
+
+    uint64_t span = 0;
+    int first_stride_dim = 0;
+    if (require_contiguous_rows) {
+        if (!rpc_u64_mul_checked((uint64_t) (t->ne[0] / blck_size), (uint64_t) type_size, &span)) {
+            return false;
+        }
+        first_stride_dim = 1;
+    } else if (blck_size == 1) {
+        span = (uint64_t) type_size;
+        first_stride_dim = 0;
+    } else {
+        const uint64_t n_blocks = (uint64_t) (t->ne[0] / blck_size);
+        if (n_blocks == 1) {
+            span = (uint64_t) type_size;
+        } else {
+            if (t->nb[0] < type_size) {
+                return false;
+            }
+            uint64_t blk_span = 0;
+            if (!rpc_u64_mul_checked(n_blocks - 1, (uint64_t) t->nb[0], &blk_span) ||
+                !rpc_u64_add_checked(blk_span, (uint64_t) type_size, &span)) {
+                return false;
+            }
+        }
+        first_stride_dim = 1;
+    }
+
+    for (int d = first_stride_dim; d < GGML_MAX_DIMS; ++d) {
+        uint64_t dim_span = 0;
+        if (!rpc_u64_mul_checked((uint64_t) (t->ne[d] - 1), (uint64_t) t->nb[d], &dim_span)) {
+            return false;
+        }
+        if (!rpc_u64_add_checked(span, dim_span, &span)) {
+            return false;
+        }
+    }
+
+    const uint64_t base     = (uint64_t) (uintptr_t) ggml_backend_buffer_get_base(t->buffer);
+    const uint64_t buf_size = (uint64_t) ggml_backend_buffer_get_size(t->buffer);
+    const uint64_t data     = (uint64_t) (uintptr_t) t->data;
+    if (data < base) {
+        return false;
+    }
+    const uint64_t offset = data - base;
+    if (offset > buf_size || span > buf_size - offset) {
+        return false;
+    }
+    if (out_start != nullptr) {
+        *out_start = data;
+    }
+    if (out_end != nullptr) {
+        *out_end = data + span;
+    }
+    return true;
+}
+
+static bool rpc_cpu_type_has_from_float(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_F32:
+        case GGML_TYPE_F16:
+        case GGML_TYPE_BF16:
+        case GGML_TYPE_Q1_0:
+        case GGML_TYPE_Q2_0:
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q8_1:
+        case GGML_TYPE_MXFP4:
+        case GGML_TYPE_NVFP4:
+        case GGML_TYPE_F8_E4M3:
+        case GGML_TYPE_Q2_K:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_IQ4_NL:
+        case GGML_TYPE_IQ4_XS:
+        case GGML_TYPE_Q8_K:
+        case GGML_TYPE_TQ1_0:
+        case GGML_TYPE_TQ2_0:
+        case GGML_TYPE_I32:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static bool rpc_cpu_get_rows_src0_type_supported(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_Q1_0:
+        case GGML_TYPE_Q2_0:
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q8_1:
+        case GGML_TYPE_MXFP4:
+        case GGML_TYPE_NVFP4:
+        case GGML_TYPE_F8_E4M3:
+        case GGML_TYPE_Q2_K:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_TQ1_0:
+        case GGML_TYPE_TQ2_0:
+        case GGML_TYPE_IQ2_XXS:
+        case GGML_TYPE_IQ2_XS:
+        case GGML_TYPE_IQ3_XXS:
+        case GGML_TYPE_IQ1_S:
+        case GGML_TYPE_IQ1_M:
+        case GGML_TYPE_IQ4_NL:
+        case GGML_TYPE_IQ4_XS:
+        case GGML_TYPE_IQ3_S:
+        case GGML_TYPE_IQ2_S:
+        case GGML_TYPE_F16:
+        case GGML_TYPE_BF16:
+        case GGML_TYPE_F32:
+        case GGML_TYPE_I32:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static bool rpc_cpu_fallback_op_allowed(const ggml_tensor * node) {
+    if (node == nullptr) {
+        return true;
+    }
+    switch (node->op) {
+        case GGML_OP_NONE:
+        case GGML_OP_DUP:
+        case GGML_OP_ADD:
+        case GGML_OP_ADD_ID:
+        case GGML_OP_ACC:
+        case GGML_OP_SUB:
+        case GGML_OP_MUL:
+        case GGML_OP_DIV:
+        case GGML_OP_SQR:
+        case GGML_OP_SQRT:
+        case GGML_OP_LOG:
+        case GGML_OP_SIN:
+        case GGML_OP_COS:
+        case GGML_OP_SUM:
+        case GGML_OP_SUM_ROWS:
+        case GGML_OP_CUMSUM:
+        case GGML_OP_MEAN:
+        case GGML_OP_ARGMAX:
+        case GGML_OP_COUNT_EQUAL:
+        case GGML_OP_REPEAT:
+        case GGML_OP_CONCAT:
+        case GGML_OP_NORM:
+        case GGML_OP_RMS_NORM:
+        case GGML_OP_GROUP_NORM:
+        case GGML_OP_L2_NORM:
+        case GGML_OP_MUL_MAT:
+        case GGML_OP_MUL_MAT_ID:
+        case GGML_OP_OUT_PROD:
+        case GGML_OP_SCALE:
+        case GGML_OP_SET:
+        case GGML_OP_CPY:
+        case GGML_OP_CONT:
+        case GGML_OP_RESHAPE:
+        case GGML_OP_VIEW:
+        case GGML_OP_PERMUTE:
+        case GGML_OP_TRANSPOSE:
+        case GGML_OP_GET_ROWS:
+        case GGML_OP_SET_ROWS:
+        case GGML_OP_DIAG:
+        case GGML_OP_SOFT_MAX:
+        case GGML_OP_ROPE:
+        case GGML_OP_CLAMP:
+        case GGML_OP_CONV_TRANSPOSE_1D:
+        case GGML_OP_IM2COL:
+        case GGML_OP_IM2COL_3D:
+        case GGML_OP_COL2IM_1D:
+        case GGML_OP_CONV_2D:
+        case GGML_OP_CONV_3D:
+        case GGML_OP_CONV_2D_DW:
+        case GGML_OP_CONV_TRANSPOSE_2D:
+        case GGML_OP_POOL_1D:
+        case GGML_OP_POOL_2D:
+        case GGML_OP_UPSCALE:
+        case GGML_OP_PAD:
+        case GGML_OP_PAD_REFLECT_1D:
+        case GGML_OP_ROLL:
+        case GGML_OP_ARANGE:
+        case GGML_OP_TIMESTEP_EMBEDDING:
+        case GGML_OP_ARGSORT:
+        case GGML_OP_TOP_K:
+        case GGML_OP_LEAKY_RELU:
+        case GGML_OP_TRI:
+        case GGML_OP_FILL:
+        case GGML_OP_FLASH_ATTN_EXT:
+        case GGML_OP_SSM_CONV:
+        case GGML_OP_SSM_SCAN:
+        case GGML_OP_WIN_PART:
+        case GGML_OP_WIN_UNPART:
+        case GGML_OP_GET_REL_POS:
+        case GGML_OP_ADD_REL_POS:
+        case GGML_OP_RWKV_WKV6:
+        case GGML_OP_GATED_LINEAR_ATTN:
+        case GGML_OP_RWKV_WKV7:
+        case GGML_OP_SOLVE_TRI:
+        case GGML_OP_GATED_DELTA_NET:
+        case GGML_OP_LIGHTNING_INDEXER:
+        case GGML_OP_DSV4_HC_COMB:
+        case GGML_OP_DSV4_HC_PRE:
+        case GGML_OP_DSV4_HC_POST:
+        case GGML_OP_TOP_K_MASK:
+            return true;
+        case GGML_OP_UNARY: {
+            const int32_t uop = ggml_get_op_params_i32(node, 0);
+            return uop >= 0 && uop < GGML_UNARY_OP_COUNT;
+        }
+        case GGML_OP_GLU: {
+            const int32_t gop = ggml_get_op_params_i32(node, 0);
+            return gop >= 0 && gop < GGML_GLU_OP_COUNT;
+        }
+        default:
+            return false;
+    }
+}
+
+static bool rpc_cpu_fallback_validate_node(
+        ggml_backend_dev_t cpu_dev,
+        const ggml_tensor * node,
+        const std::unordered_set<ggml_backend_buffer_t> & buffers) {
+    if (node == nullptr) {
+        return true;
+    }
+    if (!rpc_cpu_fallback_op_allowed(node)) {
+        return false;
+    }
+    if (rpc_op_is_noop(node->op)) {
+        return true;
+    }
+    if (cpu_dev == nullptr || !ggml_backend_dev_supports_op(cpu_dev, node)) {
+        return false;
+    }
+    if (!rpc_tensor_span_in_buffer(node, buffers, false)) {
+        return false;
+    }
+    for (int s = 0; s < GGML_MAX_SRC; ++s) {
+        if (node->src[s] != nullptr && !rpc_tensor_span_in_buffer(node->src[s], buffers, false)) {
+            return false;
+        }
+    }
+
+    const ggml_tensor * src0 = node->src[0];
+    const ggml_tensor * src1 = node->src[1];
+    const ggml_tensor * src2 = node->src[2];
+
+    switch (node->op) {
+        case GGML_OP_SET_ROWS: {
+            if (src0 == nullptr || src1 == nullptr) {
+                return false;
+            }
+            if (src0->type != GGML_TYPE_F32 && src0->type != GGML_TYPE_F16 && src0->type != GGML_TYPE_BF16) {
+                return false;
+            }
+            if (src1->type != GGML_TYPE_I64 && src1->type != GGML_TYPE_I32) {
+                return false;
+            }
+            if (!rpc_cpu_type_has_from_float(node->type)) {
+                return false;
+            }
+            if (node->ne[0] != src0->ne[0] ||
+                node->ne[2] != src0->ne[2] ||
+                node->ne[3] != src0->ne[3] ||
+                src0->ne[1] != src1->ne[0] ||
+                (src0->ne[2] % src1->ne[1]) != 0 ||
+                (src0->ne[3] % src1->ne[2]) != 0 ||
+                src1->ne[3] != 1) {
+                return false;
+            }
+            uint64_t dst_start = 0, dst_end = 0;
+            uint64_t src1_start = 0, src1_end = 0;
+            if (!rpc_tensor_span_in_buffer(node, buffers, true, &dst_start, &dst_end) ||
+                !rpc_tensor_span_in_buffer(src0, buffers, true) ||
+                !rpc_tensor_span_in_buffer(src1, buffers, false, &src1_start, &src1_end)) {
+                return false;
+            }
+            if (rpc_ranges_overlap(dst_start, dst_end, src1_start, src1_end)) {
+                return false;
+            }
+            return true;
+        }
+        case GGML_OP_GET_ROWS: {
+            if (src0 == nullptr || src1 == nullptr) {
+                return false;
+            }
+            if (src1->type != GGML_TYPE_I32 || !rpc_cpu_get_rows_src0_type_supported(src0->type)) {
+                return false;
+            }
+            const ggml_type expected_dst_type = (src0->type == GGML_TYPE_I32) ? GGML_TYPE_I32 : GGML_TYPE_F32;
+            if (node->type != expected_dst_type) {
+                return false;
+            }
+            if (node->ne[0] != src0->ne[0] ||
+                node->ne[1] != src1->ne[0] ||
+                node->ne[2] != src1->ne[1] ||
+                node->ne[3] != src1->ne[2] ||
+                src0->ne[2] != src1->ne[1] ||
+                src0->ne[3] != src1->ne[2] ||
+                src1->ne[3] != 1) {
+                return false;
+            }
+            if (src0->nb[0] != ggml_type_size(src0->type) ||
+                ggml_nelements(src1) > INT32_MAX / 2) {
+                return false;
+            }
+            uint64_t dst_start = 0, dst_end = 0;
+            uint64_t src1_start = 0, src1_end = 0;
+            if (!rpc_tensor_span_in_buffer(node, buffers, true, &dst_start, &dst_end) ||
+                !rpc_tensor_span_in_buffer(src0, buffers, true) ||
+                !rpc_tensor_span_in_buffer(src1, buffers, false, &src1_start, &src1_end)) {
+                return false;
+            }
+            if (rpc_ranges_overlap(dst_start, dst_end, src1_start, src1_end)) {
+                return false;
+            }
+            return true;
+        }
+        case GGML_OP_SOFT_MAX: {
+            if (src0 == nullptr || src0->type != GGML_TYPE_F32 || node->type != GGML_TYPE_F32) {
+                return false;
+            }
+            if (!ggml_is_contiguous(node) || !ggml_are_same_shape(src0, node)) {
+                return false;
+            }
+            if (!rpc_tensor_span_in_buffer(node, buffers, true) ||
+                !rpc_tensor_span_in_buffer(src0, buffers, true)) {
+                return false;
+            }
+            if (src1 != nullptr) {
+                if ((src1->type != GGML_TYPE_F32 && src1->type != GGML_TYPE_F16) ||
+                    src1->ne[0] != src0->ne[0] ||
+                    src1->ne[1] < src0->ne[1] ||
+                    (src0->ne[2] % src1->ne[2]) != 0 ||
+                    (src0->ne[3] % src1->ne[3]) != 0 ||
+                    !rpc_tensor_span_in_buffer(src1, buffers, true)) {
+                    return false;
+                }
+            }
+            if (src2 != nullptr) {
+                if (src2->type != GGML_TYPE_F32 ||
+                    src2->ne[0] < src0->ne[2] ||
+                    !rpc_tensor_span_in_buffer(src2, buffers, true)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        case GGML_OP_UNARY: {
+            if (src0 == nullptr || !ggml_are_same_shape(src0, node)) {
+                return false;
+            }
+            if (src0->ne[0] > INT32_MAX / 2 || ggml_nrows(src0) > INT32_MAX / 2) {
+                return false;
+            }
+            const int32_t uop = ggml_get_op_params_i32(node, 0);
+            const bool same_type_only =
+                uop == GGML_UNARY_OP_GELU ||
+                uop == GGML_UNARY_OP_GELU_ERF ||
+                uop == GGML_UNARY_OP_GELU_QUICK ||
+                uop == GGML_UNARY_OP_SILU;
+            const bool types_ok = same_type_only
+                ? (node->type == src0->type &&
+                   (src0->type == GGML_TYPE_F32 || src0->type == GGML_TYPE_F16 || src0->type == GGML_TYPE_BF16))
+                : ((src0->type == GGML_TYPE_F32 && node->type == GGML_TYPE_F32) ||
+                   (src0->type == GGML_TYPE_F16 && (node->type == GGML_TYPE_F16 || node->type == GGML_TYPE_F32)) ||
+                   (src0->type == GGML_TYPE_BF16 && (node->type == GGML_TYPE_BF16 || node->type == GGML_TYPE_F32)));
+            if (!types_ok) {
+                return false;
+            }
+            return rpc_tensor_span_in_buffer(node, buffers, true) &&
+                   rpc_tensor_span_in_buffer(src0, buffers, true);
+        }
+        case GGML_OP_LEAKY_RELU: {
+            if (src0 == nullptr || !ggml_are_same_shape(src0, node) || node->type != src0->type) {
+                return false;
+            }
+            if (src0->type != GGML_TYPE_F32 && src0->type != GGML_TYPE_F16 && src0->type != GGML_TYPE_BF16) {
+                return false;
+            }
+            if (!ggml_is_contiguous_1(src0) || !ggml_is_contiguous_1(node) ||
+                src0->nb[0] != ggml_type_size(src0->type) ||
+                node->nb[0] != ggml_type_size(node->type)) {
+                return false;
+            }
+            return rpc_tensor_span_in_buffer(node, buffers, true) &&
+                   rpc_tensor_span_in_buffer(src0, buffers, true);
+        }
+        case GGML_OP_SUM: {
+            if (src0 == nullptr || !ggml_is_scalar(node) || node->type != src0->type) {
+                return false;
+            }
+            if (src0->type != GGML_TYPE_F32 && src0->type != GGML_TYPE_F16 && src0->type != GGML_TYPE_BF16) {
+                return false;
+            }
+            if (src0->type != GGML_TYPE_F32 &&
+                (src0->nb[0] != ggml_type_size(src0->type) || !rpc_tensor_span_in_buffer(src0, buffers, true))) {
+                return false;
+            }
+            return true;
+        }
+        case GGML_OP_MEAN: {
+            if (src0 == nullptr || src0->type != GGML_TYPE_F32 || node->type != GGML_TYPE_F32) {
+                return false;
+            }
+            if (src0->nb[0] != sizeof(float) ||
+                node->ne[0] != 1 ||
+                node->ne[1] != src0->ne[1] ||
+                node->ne[2] != src0->ne[2] ||
+                node->ne[3] != src0->ne[3]) {
+                return false;
+            }
+            return rpc_tensor_span_in_buffer(src0, buffers, true);
+        }
+        case GGML_OP_ARGMAX: {
+            if (src0 == nullptr || src0->type != GGML_TYPE_F32 || node->type != GGML_TYPE_I32) {
+                return false;
+            }
+            if (src0->nb[0] != sizeof(float) ||
+                node->nb[0] != sizeof(int32_t) ||
+                node->ne[0] != src0->ne[1]) {
+                return false;
+            }
+            return rpc_tensor_span_in_buffer(src0, buffers, true) &&
+                   rpc_tensor_span_in_buffer(node, buffers, true);
+        }
+        case GGML_OP_PAD: {
+            if (src0 == nullptr || src0->type != GGML_TYPE_F32 || node->type != GGML_TYPE_F32) {
+                return false;
+            }
+            if (!ggml_is_contiguous(node)) {
+                return false;
+            }
+            const bool circular = (bool) ggml_get_op_params_i32(node, 8);
+            if (!circular) {
+                for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+                    const int64_t lp = ggml_get_op_params_i32(node, 2 * d);
+                    const int64_t rp = ggml_get_op_params_i32(node, 2 * d + 1);
+                    if (src0->ne[d] + lp + rp != node->ne[d]) {
+                        return false;
+                    }
+                }
+            }
+            return rpc_tensor_span_in_buffer(node, buffers, true);
+        }
+        case GGML_OP_MUL_MAT: {
+            if (src0 == nullptr || src1 == nullptr || node->type != GGML_TYPE_F32) {
+                return false;
+            }
+            if (src0->ne[0] != src1->ne[0] ||
+                node->ne[0] != src0->ne[1] ||
+                node->ne[1] != src1->ne[1] ||
+                node->ne[2] != src1->ne[2] ||
+                node->ne[3] != src1->ne[3] ||
+                (src1->ne[2] % src0->ne[2]) != 0 ||
+                (src1->ne[3] % src0->ne[3]) != 0) {
+                return false;
+            }
+            return rpc_tensor_span_in_buffer(src0, buffers, true) &&
+                   rpc_tensor_span_in_buffer(src1, buffers, true) &&
+                   rpc_tensor_span_in_buffer(node, buffers, true);
+        }
+        case GGML_OP_MUL_MAT_ID: {
+            if (src0 == nullptr || src1 == nullptr || src2 == nullptr) {
+                return false;
+            }
+            if (src2->type != GGML_TYPE_I32 || node->type != GGML_TYPE_F32) {
+                return false;
+            }
+            if (src0->ne[3] != 1 || src1->ne[3] != 1 || src2->ne[2] != 1 || src2->ne[3] != 1 ||
+                src0->ne[0] != src1->ne[0] ||
+                src2->ne[1] != src1->ne[2] ||
+                (src2->ne[0] % src1->ne[1]) != 0 ||
+                node->ne[0] != src0->ne[1] ||
+                node->ne[1] != src2->ne[0] ||
+                node->ne[2] != src1->ne[2] ||
+                node->ne[3] != 1) {
+                return false;
+            }
+            uint64_t dst_start = 0, dst_end = 0;
+            uint64_t src2_start = 0, src2_end = 0;
+            if (!rpc_tensor_span_in_buffer(src0, buffers, true) ||
+                !rpc_tensor_span_in_buffer(src1, buffers, true) ||
+                !rpc_tensor_span_in_buffer(node, buffers, true, &dst_start, &dst_end) ||
+                !rpc_tensor_span_in_buffer(src2, buffers, false, &src2_start, &src2_end)) {
+                return false;
+            }
+            if (rpc_ranges_overlap(dst_start, dst_end, src2_start, src2_end)) {
+                return false;
+            }
+            return true;
+        }
+        case GGML_OP_POOL_1D: {
+            if (src0 == nullptr || node->type != GGML_TYPE_F32 ||
+                (src0->type != GGML_TYPE_F32 && src0->type != GGML_TYPE_F16)) {
+                return false;
+            }
+            const int32_t op = ggml_get_op_params_i32(node, 0);
+            const int32_t k0 = ggml_get_op_params_i32(node, 1);
+            const int32_t s0 = ggml_get_op_params_i32(node, 2);
+            if ((op != GGML_OP_POOL_MAX && op != GGML_OP_POOL_AVG) || k0 <= 0 || s0 <= 0) {
+                return false;
+            }
+            if (!ggml_is_contiguous(src0) || !ggml_is_contiguous(node) ||
+                node->ne[1] != src0->ne[1] ||
+                node->ne[2] != src0->ne[2] ||
+                node->ne[3] != src0->ne[3]) {
+                return false;
+            }
+            return rpc_tensor_span_in_buffer(src0, buffers, true) &&
+                   rpc_tensor_span_in_buffer(node, buffers, true);
+        }
+        case GGML_OP_POOL_2D: {
+            if (src0 == nullptr || node->type != GGML_TYPE_F32 ||
+                (src0->type != GGML_TYPE_F32 && src0->type != GGML_TYPE_F16)) {
+                return false;
+            }
+            const int32_t op = ggml_get_op_params_i32(node, 0);
+            const int32_t k0 = ggml_get_op_params_i32(node, 1);
+            const int32_t k1 = ggml_get_op_params_i32(node, 2);
+            const int32_t s0 = ggml_get_op_params_i32(node, 3);
+            const int32_t s1 = ggml_get_op_params_i32(node, 4);
+            if ((op != GGML_OP_POOL_MAX && op != GGML_OP_POOL_AVG) ||
+                k0 <= 0 || k1 <= 0 || s0 <= 0 || s1 <= 0) {
+                return false;
+            }
+            if (!ggml_is_contiguous(src0) || !ggml_is_contiguous(node) ||
+                node->ne[2] != src0->ne[2] ||
+                node->ne[3] != src0->ne[3]) {
+                return false;
+            }
+            return rpc_tensor_span_in_buffer(src0, buffers, true) &&
+                   rpc_tensor_span_in_buffer(node, buffers, true);
+        }
+        case GGML_OP_WIN_PART: {
+            if (src0 == nullptr || src0->type != GGML_TYPE_F32 || node->type != GGML_TYPE_F32) {
+                return false;
+            }
+            const int32_t nep0 = ggml_get_op_params_i32(node, 0);
+            const int32_t nep1 = ggml_get_op_params_i32(node, 1);
+            const int32_t w    = ggml_get_op_params_i32(node, 2);
+            if (nep0 <= 0 || nep1 <= 0 || w <= 0) {
+                return false;
+            }
+            if (!ggml_is_contiguous(src0) || !ggml_is_contiguous(node) ||
+                src0->ne[3] != 1 ||
+                node->ne[0] != src0->ne[0] ||
+                node->ne[1] != w ||
+                node->ne[2] != w ||
+                node->ne[3] != (int64_t) nep0 * (int64_t) nep1) {
+                return false;
+            }
+            return rpc_tensor_span_in_buffer(src0, buffers, true) &&
+                   rpc_tensor_span_in_buffer(node, buffers, true);
+        }
+        case GGML_OP_WIN_UNPART: {
+            if (src0 == nullptr || src0->type != GGML_TYPE_F32 || node->type != GGML_TYPE_F32) {
+                return false;
+            }
+            const int32_t w = ggml_get_op_params_i32(node, 0);
+            if (w <= 0) {
+                return false;
+            }
+            if (!ggml_is_contiguous(src0) || !ggml_is_contiguous(node) ||
+                node->ne[3] != 1 ||
+                node->ne[0] != src0->ne[0] ||
+                src0->ne[1] != w ||
+                src0->ne[2] != w) {
+                return false;
+            }
+            const int64_t px  = (w - node->ne[1] % w) % w;
+            const int64_t py  = (w - node->ne[2] % w) % w;
+            const int64_t npx = (px + node->ne[1]) / w;
+            const int64_t npy = (py + node->ne[2]) / w;
+            if (src0->ne[3] != npx * npy) {
+                return false;
+            }
+            return rpc_tensor_span_in_buffer(src0, buffers, true) &&
+                   rpc_tensor_span_in_buffer(node, buffers, true);
+        }
+        default:
+            return true;
+    }
+}
+
+static const ggml_tensor * rpc_cpu_fallback_index_tensor(const ggml_tensor * node) {
+    if (node == nullptr) {
+        return nullptr;
+    }
+    switch (node->op) {
+        case GGML_OP_SET_ROWS:
+        case GGML_OP_GET_ROWS:
+            return node->src[1];
+        case GGML_OP_MUL_MAT_ID:
+            return node->src[2];
+        default:
+            return nullptr;
+    }
+}
+
+static bool rpc_cpu_fallback_validate_runtime_indices(const ggml_tensor * node) {
+    if (node == nullptr) {
+        return true;
+    }
+    switch (node->op) {
+        case GGML_OP_SET_ROWS: {
+            const ggml_tensor * src1 = node->src[1];
+            const char * base = (const char *) src1->data;
+            for (int64_t i12 = 0; i12 < src1->ne[2]; ++i12) {
+                for (int64_t i11 = 0; i11 < src1->ne[1]; ++i11) {
+                    for (int64_t i10 = 0; i10 < src1->ne[0]; ++i10) {
+                        const char * ptr = base + i10 * src1->nb[0] + i11 * src1->nb[1] + i12 * src1->nb[2];
+                        int64_t idx = -1;
+                        if (src1->type == GGML_TYPE_I64) {
+                            memcpy(&idx, ptr, sizeof(idx));
+                        } else {
+                            int32_t idx32 = -1;
+                            memcpy(&idx32, ptr, sizeof(idx32));
+                            idx = (int64_t) idx32;
+                        }
+                        if (idx < 0 || idx >= node->ne[1]) {
+                            return false;
+                        }
+                    }
+                }
+            }
+            return true;
+        }
+        case GGML_OP_GET_ROWS: {
+            const ggml_tensor * src0 = node->src[0];
+            const ggml_tensor * src1 = node->src[1];
+            const char * base = (const char *) src1->data;
+            for (int64_t i12 = 0; i12 < src1->ne[2]; ++i12) {
+                for (int64_t i11 = 0; i11 < src1->ne[1]; ++i11) {
+                    for (int64_t i10 = 0; i10 < src1->ne[0]; ++i10) {
+                        const char * ptr = base + i10 * src1->nb[0] + i11 * src1->nb[1] + i12 * src1->nb[2];
+                        int32_t idx = -1;
+                        memcpy(&idx, ptr, sizeof(idx));
+                        if (idx < 0 || idx >= src0->ne[1]) {
+                            return false;
+                        }
+                    }
+                }
+            }
+            return true;
+        }
+        case GGML_OP_MUL_MAT_ID: {
+            const ggml_tensor * src0 = node->src[0];
+            const ggml_tensor * src2 = node->src[2];
+            const char * base = (const char *) src2->data;
+            for (int64_t i21 = 0; i21 < src2->ne[1]; ++i21) {
+                for (int64_t i20 = 0; i20 < src2->ne[0]; ++i20) {
+                    const char * ptr = base + i20 * src2->nb[0] + i21 * src2->nb[1];
+                    int32_t idx = -2;
+                    memcpy(&idx, ptr, sizeof(idx));
+                    if (idx != -1 && (idx < 0 || idx >= src0->ne[2])) {
+                        return false;
+                    }
+                }
+            }
+            return true;
+        }
+        default:
+            return true;
+    }
+}
