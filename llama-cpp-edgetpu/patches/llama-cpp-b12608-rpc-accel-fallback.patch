+static bool rpc_op_is_supported_on_rpc(const ggml_tensor * node) {
+    return node != nullptr && (uint32_t) node->op < GGML_OP_COUNT &&
+           node->op != GGML_OP_MAP_CUSTOM1 && node->op != GGML_OP_MAP_CUSTOM2 &&
+           node->op != GGML_OP_MAP_CUSTOM3 && node->op != GGML_OP_CUSTOM;
+}
+
+static bool rpc_op_is_noop(enum ggml_op op) {
+    return op == GGML_OP_NONE || op == GGML_OP_RESHAPE || op == GGML_OP_VIEW ||
+           op == GGML_OP_PERMUTE || op == GGML_OP_TRANSPOSE;
+}
+
+static bool rpc_tensor_storage_in_bounds(
+        const ggml_tensor * t,
+        const std::unordered_set<ggml_backend_buffer_t> & buffers,
+        int depth = 0) {
+    if (t == nullptr || depth > 32 || (uint32_t) t->type >= GGML_TYPE_COUNT) { return false; }
+    const int64_t blck_size = ggml_blck_size(t->type);
+    const size_t  type_size = ggml_type_size(t->type);
+    if (blck_size <= 0 || type_size == 0) { return false; }
+    bool is_empty = false;
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+        if (t->ne[d] < 0 || (uint64_t) t->nb[d] > (uint64_t) INT64_MAX) { return false; }
+        is_empty = is_empty || (t->ne[d] == 0);
+    }
+    ggml_backend_buffer_t buf = t->buffer;
+    if (buf == nullptr || buffers.find(buf) == buffers.end() ||
+        !ggml_backend_buffer_is_host(buf) || t->data == nullptr) { return false; }
+    uint64_t span = 0;
+    if (!is_empty) {
+        if ((t->ne[0] % blck_size) != 0 || t->nb[0] < type_size) { return false; }
+        int first_dim = 0;
+        if (blck_size > 1) {
+            const uint64_t n_blocks = (uint64_t) (t->ne[0] / blck_size);
+            if (n_blocks > UINT64_MAX / (uint64_t) t->nb[0]) { return false; }
+            span = n_blocks * (uint64_t) t->nb[0];
+            first_dim = 1;
+        } else {
+            span = (uint64_t) type_size;
+        }
+        for (int d = first_dim; d < GGML_MAX_DIMS; ++d) {
+            const uint64_t count  = (uint64_t) (t->ne[d] - 1);
+            const uint64_t stride = (uint64_t) t->nb[d];
+            if (count != 0) {
+                if (stride < type_size || stride > (UINT64_MAX - span) / count) { return false; }
+                span += count * stride;
+            }
+        }
+    }
+    const uint64_t base     = (uint64_t) (uintptr_t) ggml_backend_buffer_get_base(buf);
+    const uint64_t buf_size = (uint64_t) ggml_backend_buffer_get_size(buf);
+    const uint64_t data     = (uint64_t) (uintptr_t) t->data;
+    if (base == 0 || data < base || (data - base) > buf_size || span > buf_size - (data - base)) { return false; }
+    if (t->view_src != nullptr) {
+        if (!rpc_tensor_storage_in_bounds(t->view_src, buffers, depth + 1)) { return false; }
+        const uint64_t src_data = (uint64_t) (uintptr_t) t->view_src->data;
+        if (t->view_src->buffer != buf || (uint64_t) t->view_offs > UINT64_MAX - src_data ||
+            src_data + (uint64_t) t->view_offs != data) { return false; }
+    }
+    return true;
+}
+
+static bool rpc_node_storage_valid(
+        const ggml_tensor * node,
+        const std::unordered_set<ggml_backend_buffer_t> & buffers) {
+    if (!rpc_tensor_storage_in_bounds(node, buffers)) { return false; }
+    for (int s = 0; s < GGML_MAX_SRC; ++s) {
+        if (node->src[s] != nullptr && !rpc_tensor_storage_in_bounds(node->src[s], buffers)) { return false; }
+    }
+    return true;
+}
+
+static bool rpc_op_checks_indices(enum ggml_op op) {
+    return op == GGML_OP_SET_ROWS || op == GGML_OP_GET_ROWS || op == GGML_OP_MUL_MAT_ID;
+}
+
+static bool rpc_cpu_fallback_indices_valid(const ggml_tensor * node) {
+    if (node == nullptr) { return false; }
+    if (node->op == GGML_OP_SET_ROWS) {
+        const ggml_tensor * src0 = node->src[0], * src1 = node->src[1];
+        if (!src0 || !src1 || !src1->data) { return false; }
+        for (int64_t i12 = 0; i12 < src1->ne[2]; ++i12) {
+            for (int64_t i11 = 0; i11 < src1->ne[1]; ++i11) {
+                for (int64_t i10 = 0; i10 < src0->ne[1]; ++i10) {
+                    const char * p = (const char *) src1->data + i10 * src1->nb[0] + i11 * src1->nb[1] + i12 * src1->nb[2];
+                    int64_t idx = 0;
+                    if (src1->type == GGML_TYPE_I64) { memcpy(&idx, p, sizeof(int64_t)); }
+                    else { int32_t v = 0; memcpy(&v, p, sizeof(int32_t)); idx = v; }
+                    if (idx < 0 || idx >= node->ne[1]) { return false; }
+                }
+            }
+        }
+    } else if (node->op == GGML_OP_GET_ROWS) {
+        const ggml_tensor * src0 = node->src[0], * src1 = node->src[1];
+        if (!src0 || !src1 || !src1->data) { return false; }
+        for (int64_t i12 = 0; i12 < src1->ne[2]; ++i12) {
+            for (int64_t i11 = 0; i11 < src1->ne[1]; ++i11) {
+                for (int64_t i10 = 0; i10 < src1->ne[0]; ++i10) {
+                    int32_t idx = 0;
+                    memcpy(&idx, (const char *) src1->data + i10 * src1->nb[0] + i11 * src1->nb[1] + i12 * src1->nb[2], sizeof(int32_t));
+                    if (idx < 0 || idx >= src0->ne[1]) { return false; }
+                }
+            }
+        }
+    } else if (node->op == GGML_OP_MUL_MAT_ID) {
+        const ggml_tensor * src0 = node->src[0], * ids = node->src[2];
+        if (!src0 || !ids || !ids->data) { return false; }
+        for (int64_t iid1 = 0; iid1 < ids->ne[1]; ++iid1) {
+            for (int64_t id = 0; id < ids->ne[0]; ++id) {
+                int32_t idx = 0;
+                memcpy(&idx, (const char *) ids->data + iid1 * ids->nb[1] + id * ids->nb[0], sizeof(int32_t));
+                if (idx != -1 && (idx < 0 || idx >= src0->ne[2])) { return false; }
+            }
+        }
+    }
+    return true;
+}
+
+static bool rpc_cpu_fallback_op_valid(ggml_backend_dev_t cpu_dev, const ggml_tensor * node) {
+    if (node == nullptr) { return false; }
+    if (rpc_op_is_noop(node->op)) { return true; }
+    auto safe_nelems = [](const ggml_tensor * t, uint64_t & nelems) {
+        if (!t || (uint32_t) t->type >= GGML_TYPE_COUNT) { return false; }
+        const int64_t blck = ggml_blck_size(t->type);
+        const size_t  ts   = ggml_type_size(t->type);
+        if (blck <= 0 || ts == 0 || t->ne[0] <= 0 || (t->ne[0] % blck) != 0 ||
+            (uint64_t) t->ne[0] > (uint64_t) INT64_MAX / (uint64_t) ts) { return false; }
+        uint64_t n = (uint64_t) t->ne[0];
+        for (int d = 1; d < GGML_MAX_DIMS; ++d) {
+            if (t->ne[d] <= 0 || (uint64_t) t->ne[d] > (uint64_t) INT64_MAX / n) { return false; }
+            n *= (uint64_t) t->ne[d];
+        }
+        nelems = n;
+        return true;
+    };
+    auto f32_contig = [](const ggml_tensor * t) {
+        if (!t || t->type != GGML_TYPE_F32 || t->nb[0] != sizeof(float) || !ggml_is_contiguous(t) ||
+            t->ne[0] <= 0 || t->ne[0] > INT32_MAX / 2) { return false; }
+        uint64_t nrows = 1;
+        for (int d = 1; d < GGML_MAX_DIMS; ++d) {
+            if (t->ne[d] <= 0 || (uint64_t) t->ne[d] > (uint64_t) (INT32_MAX / 2) / nrows) { return false; }
+            nrows *= (uint64_t) t->ne[d];
+        }
+        return true;
+    };
+    auto row_contig = [&](const ggml_tensor * t, uint64_t & nelems) {
+        if (!safe_nelems(t, nelems) || t->nb[0] != ggml_type_size(t->type) || !ggml_is_contiguous_rows(t)) {
+            return false;
+        }
+        uint64_t min_stride = (uint64_t) ggml_row_size(t->type, t->ne[0]);
+        for (int d = 1; d < GGML_MAX_DIMS; ++d) {
+            if (t->ne[d] > 1) {
+                if ((uint64_t) t->nb[d] < min_stride || (uint64_t) t->ne[d] > UINT64_MAX / (uint64_t) t->nb[d]) { return false; }
+                min_stride = (uint64_t) t->ne[d] * (uint64_t) t->nb[d];
+            }
+        }
+        return true;
+    };
+    auto has_cpu_from_float = [](enum ggml_type t) {
+        if (t == GGML_TYPE_IQ3_XXS || t == GGML_TYPE_IQ3_S || t == GGML_TYPE_IQ2_XXS ||
+            t == GGML_TYPE_IQ2_XS  || t == GGML_TYPE_IQ2_S || t == GGML_TYPE_IQ1_S ||
+            t == GGML_TYPE_IQ1_M) { return false; }
+        return t == GGML_TYPE_F32 || t == GGML_TYPE_I32 || t == GGML_TYPE_Q8_K ||
+               ggml_get_type_traits(t)->from_float_ref != nullptr;
+    };
+    switch (node->op) {
+        case GGML_OP_SCALE:
+        case GGML_OP_RMS_NORM: {
+            const ggml_tensor * src0 = node->src[0];
+            if (!f32_contig(node) || !f32_contig(src0) || !ggml_are_same_shape(src0, node)) { return false; }
+            if (node->op == GGML_OP_RMS_NORM) {
+                float eps = -1.0f;
+                memcpy(&eps, node->op_params, sizeof(float));
+                if (!(eps >= 0.0f)) { return false; }
+            }
+            return cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node);
+        }
+        case GGML_OP_ADD:
+        case GGML_OP_SUB:
+        case GGML_OP_MUL:
+        case GGML_OP_DIV: {
+            const ggml_tensor * src0 = node->src[0], * src1 = node->src[1];
+            return f32_contig(node) && f32_contig(src0) && f32_contig(src1) &&
+                   ggml_are_same_shape(src0, node) && ggml_can_repeat(src1, src0) &&
+                   (cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node));
+        }
+        case GGML_OP_MUL_MAT: {
+            const ggml_tensor * src0 = node->src[0], * src1 = node->src[1];
+            uint64_t src0_n = 0, src1_n = 0, dst_n = 0;
+            const bool q8_act = src0 && src1 && src1->type == GGML_TYPE_Q8_0 &&
+                                (src0->type == GGML_TYPE_Q8_0 || src0->type == GGML_TYPE_Q4_0);
+            if (ggml_get_op_params_i32(node, 1) == GGML_HINT_SRC0_IS_HADAMARD ||
+                !row_contig(node, dst_n) || !row_contig(src0, src0_n) || !row_contig(src1, src1_n) ||
+                node->type != GGML_TYPE_F32 || src1_n > (32ull << 20) ||
+                !(node->nb[0] <= node->nb[1] && node->nb[1] <= node->nb[2] && node->nb[2] <= node->nb[3]) ||
+                (!q8_act && src1->type != GGML_TYPE_F32 && src1->type != GGML_TYPE_F16 && src1->type != GGML_TYPE_BF16) ||
+                (src0->type != GGML_TYPE_F32 && src0->type != GGML_TYPE_F16 && src0->type != GGML_TYPE_BF16 &&
+                 ggml_get_type_traits(src0->type)->to_float == nullptr)) { return false; }
+            return src0->ne[0] == src1->ne[0] && node->ne[0] == src0->ne[1] &&
+                   node->ne[1] == src1->ne[1] && node->ne[2] == src1->ne[2] && node->ne[3] == src1->ne[3] &&
+                   (src1->ne[2] % src0->ne[2]) == 0 && (src1->ne[3] % src0->ne[3]) == 0 &&
+                   (cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node));
+        }
+        case GGML_OP_MUL_MAT_ID: {
+            const ggml_tensor * src0 = node->src[0], * src1 = node->src[1], * ids = node->src[2];
+            uint64_t src0_n = 0, src1_n = 0, ids_n = 0, dst_n = 0;
+            const bool q8_act = src0 && src1 && src1->type == GGML_TYPE_Q8_0 &&
+                                (src0->type == GGML_TYPE_Q8_0 || src0->type == GGML_TYPE_Q4_0);
+            if (ggml_get_op_params_i32(node, 1) == GGML_HINT_SRC0_IS_HADAMARD ||
+                !row_contig(node, dst_n) || !row_contig(src0, src0_n) || !row_contig(src1, src1_n) || !row_contig(ids, ids_n) ||
+                node->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32 ||
+                !(node->nb[0] <= node->nb[1] && node->nb[1] <= node->nb[2] && node->nb[2] <= node->nb[3]) ||
+                (!q8_act && src1->type != GGML_TYPE_F32) ||
+                (src0->type != GGML_TYPE_F32 && src0->type != GGML_TYPE_F16 && src0->type != GGML_TYPE_BF16 &&
+                 ggml_get_type_traits(src0->type)->to_float == nullptr)) { return false; }
+            if (src0->ne[3] != 1 || src1->ne[3] != 1 || ids->ne[2] != 1 || ids->ne[3] != 1 || node->ne[3] != 1 ||
+                src0->ne[0] != src1->ne[0] || src1->ne[2] != ids->ne[1] || (ids->ne[0] % src1->ne[1]) != 0 ||
+                node->ne[0] != src0->ne[1] || node->ne[1] != ids->ne[0] || node->ne[2] != ids->ne[1]) { return false; }
+            if (src1_n > (32ull << 20) || src0->ne[2] > (1ll << 16) ||
+                ids_n > (8ull << 20) || (uint64_t) src0->ne[2] > (8ull << 20) / ids_n) { return false; }
+            return cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node);
+        }
+        case GGML_OP_SET_ROWS: {
+            const ggml_tensor * src0 = node->src[0], * src1 = node->src[1];
+            uint64_t src0_n = 0, src1_n = 0, dst_n = 0;
+            if (!row_contig(node, dst_n) || !row_contig(src0, src0_n) || !row_contig(src1, src1_n) ||
+                !has_cpu_from_float(node->type) ||
+                (src0->type != GGML_TYPE_F32 && src0->type != GGML_TYPE_F16 && src0->type != GGML_TYPE_BF16) ||
+                (src1->type != GGML_TYPE_I64 && src1->type != GGML_TYPE_I32)) { return false; }
+            if (node->ne[0] != src0->ne[0] || node->ne[2] != src0->ne[2] || node->ne[3] != src0->ne[3] ||
+                src1->ne[0] != src0->ne[1] || src1->ne[3] != 1 ||
+                (src0->ne[2] % src1->ne[1]) != 0 || (src0->ne[3] % src1->ne[2]) != 0 ||
+                src0->ne[0] > (16 << 20) || src1_n > (32ull << 20)) { return false; }
+            return cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node);
+        }
+        case GGML_OP_GET_ROWS: {
+            const ggml_tensor * src0 = node->src[0], * src1 = node->src[1];
+            uint64_t src0_n = 0, src1_n = 0, dst_n = 0;
+            if (!row_contig(node, dst_n) || !row_contig(src0, src0_n) || !row_contig(src1, src1_n) ||
+                src1->type != GGML_TYPE_I32 ||
+                node->type != (src0->type == GGML_TYPE_I32 ? GGML_TYPE_I32 : GGML_TYPE_F32)) { return false; }
+            const bool src0_ok = src0->type == GGML_TYPE_F32 || src0->type == GGML_TYPE_I32 ||
+                                 src0->type == GGML_TYPE_F16 || src0->type == GGML_TYPE_BF16 ||
+                                 ((ggml_is_quantized(src0->type) || src0->type == GGML_TYPE_F8_E4M3) &&
+                                  ggml_get_type_traits(src0->type)->to_float != nullptr);
+            if (!src0_ok || src1->ne[3] != 1 || src1_n > (32ull << 20) ||
+                node->ne[0] != src0->ne[0] || node->ne[1] != src1->ne[0] ||
+                node->ne[2] != src1->ne[1] || src0->ne[2] != src1->ne[1] ||
+                node->ne[3] != src1->ne[2] || src0->ne[3] != src1->ne[2]) { return false; }
+            return cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node);
+        }
+        case GGML_OP_CPY:
+        case GGML_OP_CONT:
+        case GGML_OP_DUP: {
+            const ggml_tensor * src0 = node->src[0], * src1 = node->src[1];
+            uint64_t src0_n = 0, dst_n = 0;
+            if (!safe_nelems(node, dst_n) || !safe_nelems(src0, src0_n) ||
+                src0_n != dst_n || dst_n > (uint64_t) INT32_MAX ||
+                src0->ne[0] > (16 << 20) || node->ne[0] > (16 << 20)) { return false; }
+            if (node->op == GGML_OP_CPY) {
+                if (!src1 || src1->type != node->type || !ggml_are_same_shape(src1, node)) { return false; }
+                for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+                    if (src1->nb[d] != node->nb[d]) { return false; }
+                }
+            } else if (node->op == GGML_OP_CONT) {
+                if (src0->type != node->type || !ggml_is_contiguous(node) ||
+                    node->nb[0] != ggml_type_size(node->type)) { return false; }
+            }
+            if (ggml_is_contiguous(node) && node->nb[0] != ggml_type_size(node->type)) { return false; }
+            if (ggml_is_contiguous(src0) && src0->nb[0] != ggml_type_size(src0->type)) { return false; }
+            if (src0->type == node->type) {
+                if (ggml_blck_size(src0->type) > 1 &&
+                    (src0->nb[0] != ggml_type_size(src0->type) || node->nb[0] != ggml_type_size(node->type) ||
+                     (ggml_is_contiguous(node) && !ggml_is_contiguous(src0) && !ggml_are_same_shape(src0, node)))) {
+                    return false;
+                }
+                return cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node);
+            }
+            const bool dst_flt = node->type == GGML_TYPE_F16 || node->type == GGML_TYPE_BF16 ||
+                                 node->type == GGML_TYPE_F32 || node->type == GGML_TYPE_F8_E4M3;
+            if (src0->type == GGML_TYPE_F16 || src0->type == GGML_TYPE_BF16 || src0->type == GGML_TYPE_F32) {
+                if (dst_flt || (src0->type == GGML_TYPE_F32 && node->type == GGML_TYPE_I32)) {
+                    return cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node);
+                }
+                if (node->op != GGML_OP_CONT && ggml_is_quantized(node->type) && has_cpu_from_float(node->type) &&
+                    ggml_is_contiguous(node) && node->nb[0] == ggml_type_size(node->type) &&
+                    src0->nb[0] == ggml_type_size(src0->type) &&
+                    src0->ne[0] <= node->ne[0] && (src0->ne[0] % ggml_blck_size(node->type)) == 0) {
+                    return cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node);
+                }
+                return false;
+            }
+            if (src0->type == GGML_TYPE_F8_E4M3) {
+                return (node->type == GGML_TYPE_F16 || node->type == GGML_TYPE_BF16 || node->type == GGML_TYPE_F32) &&
+                       (cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node));
+            }
+            if (src0->type == GGML_TYPE_I32) {
+                return node->type == GGML_TYPE_F32 &&
+                       (cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node));
+            }
+            if (node->op == GGML_OP_CPY && ggml_is_quantized(src0->type) && node->type == GGML_TYPE_F32 &&
+                ggml_get_type_traits(src0->type)->to_float != nullptr &&
+                src0->nb[0] == ggml_type_size(src0->type) && node->nb[0] == sizeof(float) &&
+                ((node->ne[0] % ggml_blck_size(src0->type)) == 0 || ggml_is_contiguous(node))) {
+                return cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node);
+            }
+            return false;
+        }
+        case GGML_OP_ROPE: {
+            const ggml_tensor * src0 = node->src[0], * src1 = node->src[1], * src2 = node->src[2];
+            uint64_t src0_n = 0, src1_n = 0, dst_n = 0;
+            if (!safe_nelems(node, dst_n) || !safe_nelems(src0, src0_n) || !safe_nelems(src1, src1_n) ||
+                src0->type != node->type || src1->type != GGML_TYPE_I32 ||
+                (src0->type != GGML_TYPE_F32 && src0->type != GGML_TYPE_F16 && src0->type != GGML_TYPE_BF16) ||
+                !ggml_are_same_shape(src0, node) ||
+                src0->nb[0] != ggml_type_size(src0->type) || node->nb[0] != src0->nb[0] ||
+                !ggml_is_contiguous(src1) || src1->nb[0] != sizeof(int32_t) ||
+                (node->ne[0] % 2) != 0 || node->ne[0] > (16 << 20) ||
+                dst_n / (uint64_t) node->ne[0] > (uint64_t) (INT32_MAX / 2)) { return false; }
+            const int32_t n_dims = ggml_get_op_params_i32(node, 1);
+            const int32_t mode   = ggml_get_op_params_i32(node, 2);
+            const int32_t n_offs = ggml_get_op_params_i32(node, 15);
+            if (n_dims <= 0 || (n_dims % 2) != 0 || n_offs < 0 || (n_offs % 2) != 0 ||
+                n_dims > node->ne[0] || n_offs > node->ne[0] - n_dims) { return false; }
+            if (mode != GGML_ROPE_TYPE_NORMAL && mode != GGML_ROPE_TYPE_NEOX &&
+                mode != GGML_ROPE_TYPE_MROPE  && mode != GGML_ROPE_TYPE_IMROPE &&
+                mode != GGML_ROPE_TYPE_VISION) { return false; }
+            if (mode == GGML_ROPE_TYPE_VISION && (n_dims != node->ne[0] / 2 || n_offs != 0)) { return false; }
+            if ((mode & GGML_ROPE_TYPE_MROPE) != 0) {
+                int64_t sect_dims = 0;
+                for (int s = 0; s < 4; ++s) {
+                    const int32_t sv = ggml_get_op_params_i32(node, 11 + s);
+                    if (sv < 0) { return false; }
+                    sect_dims += sv;
+                }
+                if (sect_dims <= 0 || sect_dims > node->ne[0] ||
+                    (ggml_get_op_params_i32(node, 11) <= 0 && ggml_get_op_params_i32(node, 12) <= 0 &&
+                     ggml_get_op_params_i32(node, 13) <= 0) ||
+                    src1_n < (uint64_t) node->ne[2] * 4) { return false; }
+            } else if (src1_n < (uint64_t) node->ne[2]) { return false; }
+            if (src2 != nullptr) {
+                uint64_t src2_n = 0;
+                if (!safe_nelems(src2, src2_n) || src2->type != GGML_TYPE_F32 ||
+                    !ggml_is_contiguous(src2) || src2->nb[0] != sizeof(float) ||
+                    src2->ne[0] < n_dims / 2 || src2_n < (uint64_t) (node->ne[0] / 2)) { return false; }
+            }
+            return cpu_dev == nullptr || ggml_backend_dev_supports_op(cpu_dev, node);
+        }
+        default:
+            return false;
+    }
+}
