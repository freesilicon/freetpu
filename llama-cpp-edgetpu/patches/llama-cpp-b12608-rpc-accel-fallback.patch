+ggml_status rpc_server::compute_graph_with_accel_fallback(uint32_t device, ggml_cgraph * graph) {
+    ggml_backend_t backend = backends[device];
+    ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+    if (!cpu_fallback || !dev || ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_ACCEL ||
+        !ggml_backend_buft_is_host(ggml_backend_get_default_buffer_type(backend))) {
+        return ggml_backend_graph_compute_async(backend, graph);
+    }
+
+    int i = 0;
+    while (i < graph->n_nodes) {
+        while (i < graph->n_nodes &&
+               (graph->nodes[i] == nullptr ||
+                (graph->nodes[i]->flags & GGML_TENSOR_FLAG_COMPUTE) == 0)) {
+            ++i;
+        }
+        if (i >= graph->n_nodes) {
+            break;
+        }
+        if (!rpc_op_is_supported_on_rpc(graph->nodes[i]) ||
+            !rpc_node_storage_valid(graph->nodes[i], buffers)) {
+            LOG_ERROR("[%s] rejecting invalid RPC node %d (op=%d)\n", __func__, i, (int) graph->nodes[i]->op);
+            return GGML_STATUS_FAILED;
+        }
+        const bool use_accel = ggml_backend_dev_supports_op(dev, graph->nodes[i]);
+        int j = i + 1;
+        while (j < graph->n_nodes) {
+            ggml_tensor * node = graph->nodes[j];
+            if (node == nullptr || (node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+                break;
+            }
+            if (!rpc_op_is_supported_on_rpc(node) ||
+                !rpc_node_storage_valid(node, buffers)) {
+                LOG_ERROR("[%s] rejecting invalid RPC node %d (op=%d)\n", __func__, j, (int) node->op);
+                return GGML_STATUS_FAILED;
+            }
+            if (ggml_backend_dev_supports_op(dev, node) != use_accel) {
+                break;
+            }
+            ++j;
+        }
+        struct ggml_cgraph sub = ggml_graph_view(graph, i, j);
+        ggml_status status = GGML_STATUS_SUCCESS;
+        if (use_accel) {
+            status = ggml_backend_graph_compute_async(backend, &sub);
+            if (status == GGML_STATUS_SUCCESS) {
+                ggml_backend_synchronize(backend);
+            }
+        } else {
+            status = ggml_backend_graph_compute(cpu_fallback, &sub);
+        }
+        if (status != GGML_STATUS_SUCCESS) {
+            return status;
+        }
+        i = j;
+    }
+    return GGML_STATUS_SUCCESS;
+}
