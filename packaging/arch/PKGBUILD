# SPDX-License-Identifier: Apache-2.0
# Maintainer: OmaMobile Contributors
#
# Clean-room userspace stack for Tensor G5 (laguna) EdgeTPU (/dev/edgetpu-soc):
#   - libopenbuenos static library (built -fPIC) + CMake package + headers
#   - tpu_baremetal_runner and openbuenos_selftest CLI utilities
#   - udev rules for non-root access to /dev/edgetpu-soc and /dev/dma_heap/system
#
# Proprietary firmware (google/edgetpu-buenos.fw) and the RV64 interpreter binary
# (dive_interp_rv64.bin) are NOT packaged here; extract them from the device
# owner's vendor/factory image via tools/extract-vendor-firmware.

pkgname=omamobile-freetpu
pkgver=0.1.0
pkgrel=1
pkgdesc='Clean-room userspace runtime and bare-metal runner for Google Tensor G5 (laguna) EdgeTPU'
arch=(aarch64)
url='https://github.com/saariuslystoned/freetpu'
license=(Apache-2.0)
depends=(glibc gcc-libs)
makedepends=(cmake ninja gcc)
optdepends=(
  'linux-omamobile: mainline Tensor G5 EdgeTPU kernel driver (/dev/edgetpu-soc)'
)
provides=(libopenbuenos freetpu)
source=(
  "freetpu-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
  99-edgetpu.rules
)
sha256sums=('SKIP' 'SKIP')

build() {
  cmake -S "freetpu-$pkgver/libopenbuenos" -B build-lib -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DOPENBUENOS_BUILD_TESTS=ON \
    -DOPENBUENOS_INSTALL_SELFTEST=ON \
    -DOPENBUENOS_WERROR=OFF
  cmake --build build-lib

  cmake -S "freetpu-$pkgver/runtime" -B build-runtime -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DFREETPU_RUNTIME_WERROR=OFF
  cmake --build build-runtime
}

check() {
  ctest --test-dir build-lib --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build-lib
  DESTDIR="$pkgdir" cmake --install build-runtime

  install -Dm644 "$srcdir/99-edgetpu.rules" \
    "$pkgdir/usr/lib/udev/rules.d/99-edgetpu.rules"
  install -Dm644 "freetpu-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
