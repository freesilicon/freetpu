# HELP freetpu_exporter_up Whether the FreeTPU exporter scrape succeeded (1 = up).
# TYPE freetpu_exporter_up gauge
freetpu_exporter_up 1
# HELP freetpu_tpu_devices_discovered Total Google TPU PCI devices (vendor 0x1ae0) discovered in sysfs.
# TYPE freetpu_tpu_devices_discovered gauge
freetpu_tpu_devices_discovered 8
# HELP freetpu_tpu_scrape_duration_seconds Time taken to scrape TPU PCI/VFIO and telemetry sources in seconds.
# TYPE freetpu_tpu_scrape_duration_seconds gauge
freetpu_tpu_scrape_duration_seconds 0.093452
# HELP freetpu_tpu_info_available Whether the tpu-info CLI returned telemetry cleanly (1 = yes, 0 = fallback).
# TYPE freetpu_tpu_info_available gauge
freetpu_tpu_info_available 0
# HELP freetpu_tpu_info Static inventory metadata for each discovered TPU device.
# TYPE freetpu_tpu_info gauge
freetpu_tpu_info{chip="0",pci_bdf="0000:00:0b.0",device_id="0x006f",generation="v6e",vfio_device="/dev/vfio/3",vendor="0x1ae0",model="TPU v6e (Trillium)",driver="vfio-pci",iommu_group="3",telemetry_source="sysfs-fallback"} 1
